# Existing parser integration
MICRO_APP_URL=

# Optional Supabase Storage workspace persistence. Leave all three unset for
# the existing local-disk-only workflow.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_WORKSPACE_BUCKET=degreebaba-workspaces

# Production safeguards
MAX_REQUEST_BYTES=26214400
ENABLE_FRONTEND_REBUILD=false
ENABLE_DEVELOPMENT_ENDPOINTS=false
LOG_LEVEL=INFO
